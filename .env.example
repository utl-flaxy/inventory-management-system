# Sample only: empty secrets intentionally fail validation. Generate independent secrets before use.
DB_NAME=asset_management
DB_USERNAME=inventory_app
DB_PASSWORD=
DB_ROOT_PASSWORD=
JWT_SECRET=
# Required app RAM/swap ceiling, e.g. 1g only after verifying host/DB/build headroom.
# See docs/docker-runtime.md for 1/2/4/8 GiB capacity planning; no host capacity is assumed.
APP_MEMORY_LIMIT=
# Required for prod: measure the app-observed Caddy transport peer(s). Gateway inspection alone is insufficient.
# Exact verified IPs only, comma separated; empty/missing prevents rollout. Never copy an example Docker IP.
LOGIN_TRUSTED_PROXIES=
